include README.md README.zh-CN.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md ROADMAP.md
include uv.lock .env.example .gitignore .gitattributes Makefile
recursive-include docs *.md
recursive-include examples *.py *.jsonl
recursive-include scripts *.py
recursive-include tests *.py
recursive-include benchmarks *.jsonl *.json *.md
recursive-include .github *.yml *.md
global-exclude *.py[cod] .DS_Store
